# =============================================================================
# selective-regeneration-pipeline .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# --- Virtual environments ---
.venv/
venv/
ENV/
env/
.python-version

# --- Jupyter Notebook ---
.ipynb_checkpoints/
*.ipynb_checkpoints/

# --- PyTest ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.pytest_cache/v/cache/lastfailed
.pytest_cache/v/cache/nodeids
.pytest_cache/v/cache/stepwise

# --- Ruff ---
.ruff_cache/

# --- Mypy ---
.mypy_cache/

# --- IDE: VS Code ---
.vscode/
*.code-workspace

# --- IDE: JetBrains (PyCharm, IntelliJ) ---
.idea/
*.iml
*.iws
*.ipr

# --- IDE: Eclipse ---
.project
.classpath
.settings/

# --- OS system files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Kaggle runtime artifacts ---
runtime/
snapshots/
results/
logs/
*.jsonl
kaggle.json

# --- Generated experiment outputs ---
*.zip
*.tar
*.tar.gz
*.gz
*.tar.bz2

# --- Model artifacts (never commit) ---
*.bin
*.safetensors
*.gguf
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.joblib

# --- Secrets and tokens ---
.env
.env.*
*.key
*.pem
secrets.json
credentials.json

# --- Temporary files ---
*.tmp
*.temp
*.swp
*.swo
*~
